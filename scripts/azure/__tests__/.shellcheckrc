# Scoped to scripts/azure/__tests__/ only (shellcheck discovers this file by
# walking up from each source file's own directory) - deliberately does NOT
# cover scripts/azure/'s production scripts (branch-namespace.sh,
# housekeeping-sweep.sh, provision-shared-repo.sh, verify-worktree-deps.sh).
# This file originally lived at scripts/azure/.shellcheckrc, which - via the
# same walking-up mechanism - silently covered those production scripts too,
# even though none of them use the pattern this suppression exists for
# (verified by search). SC2034 in particular is the classic assign-`foo`/
# read-`$food` typo catcher, so leaving it off for code that actually runs
# on the VM was a real, if latent, gap - moved here specifically to close it
# (Evaluator eval-round-04 finding; no live bug found when the production
# scripts were audited for it, but the blind spot itself was real).
#
# Both disables below exist for ONE reason: lib.sh's `azure_test_assert`
# helper takes a shell CONDITION as a single-quoted STRING and evaluates it
# later via `eval`, deliberately - the whole point is deferring evaluation
# to assert-time rather than call-time. Every test in this suite (52+
# checks across 9 files) uses this pattern.
#
# SC2016 ("expressions don't expand in single quotes") is the CORRECT
# observation applied to the WRONG intent: not expanding at the call site is
# exactly what's wanted here. Quoting the string differently would break the
# deferred-evaluation design, not fix a bug.
#
# SC2034 ("X appears unused") fires on variables that ARE used, but only
# inside one of these deferred-eval string literals - shellcheck's static
# analysis has no way to see into a string it doesn't parse as code, so it
# reports a false unused-variable warning for every variable referenced only
# this way.
#
# Verified before disabling, not assumed: every SC2016/SC2034 hit in this
# directory's shellcheck output (eval round 4) was inside or downstream of
# an azure_test_assert call - none were a genuine bug the suppression would
# hide. A real, unrelated array-usage bug in the SAME run (concurrency.test.sh's
# `declare -a results_dir`, SC2178/SC2128) was fixed directly, not suppressed,
# because it was NOT part of this pattern.
disable=SC2016
disable=SC2034

# Actually follow `source ./lib.sh` / `source ../branch-namespace.sh` when
# checking these files, using each file's own `# shellcheck source=...`
# directive to know where to look. Without this, shellcheck reports SC1091
# ("not following") for every source line regardless of the directive - the
# directive only says WHICH path to use IF following is enabled; it doesn't
# enable following by itself. That "info"-severity SC1091 note still fails
# this pre-commit hook's exit code, so this is required for the hook to pass
# cleanly, not just cosmetic (found the hard way in eval round 4 - a `source=`
# directive alone did not clear it).
external-sources=true
