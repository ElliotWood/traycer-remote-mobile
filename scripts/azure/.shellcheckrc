# Scoped to scripts/azure/ (production scripts: branch-namespace.sh,
# housekeeping-sweep.sh, provision-shared-repo.sh, verify-worktree-deps.sh).
# Deliberately does NOT disable any check - see
# scripts/azure/__tests__/.shellcheckrc for why that file's SC2016/SC2034
# disables are scoped to __tests__/ only and not duplicated here.
#
# `external-sources=true` makes shellcheck actually follow
# provision-shared-repo.sh's `# shellcheck source=./branch-namespace.sh`
# directive instead of just noting where to look. Without it, the "info"-
# severity SC1091 ("not following: ... was not specified as input") still
# fails this repo's pre-commit shellcheck hook, even with a correct
# `source=` directive in place - the directive alone only says WHICH path to
# use IF following is enabled, it does not enable following by itself.
external-sources=true
