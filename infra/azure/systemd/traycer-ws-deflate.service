[Unit]
Description=Traycer WebSocket deflate relay (compresses the internet-facing leg)
After=network.target

[Service]
Type=simple
User=traycer
ExecStart=/usr/bin/node /usr/local/lib/traycer/traycer-ws-deflate-proxy.mjs 45080 /srv/traycer/tenants/elliot/.traycer/host/pid.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
