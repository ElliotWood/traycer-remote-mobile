{
  "name": "@traycer-clients/teams-tab",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "compile": "tsc -b",
    "preview": "vite preview",
    "test": "node tools/check-canvas-core.mjs && vitest run",
    "lint": "eslint . --max-warnings 0",
    "check-canvas-core": "node tools/check-canvas-core.mjs",
    "//test": "ORDER IS LOAD-BEARING. The drift checker runs FIRST and `&&` means the suite does not run if it fails: drifted copies of the lifted canvas core make every canvas test a statement about the wrong code, so a green suite against a diverged copy is worse than a red one. Do not split this into two scripts, reorder it, or swap `&&` for `;` so both always run - each of those disarms the gate while leaving it looking present."
  },
  "dependencies": {
    "@fluentui/react-components": "^9.71.0",
    "@fluentui/react-icons": "^2.0.334",
    "@microsoft/teams-js": "^2.44.0",
    "@traycer-clients/shared": "workspace:*",
    "@traycer/protocol": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-task-item": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/y-tiptap": "catalog:",
    "diff": "catalog:",
    "mermaid": "^11.16.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
