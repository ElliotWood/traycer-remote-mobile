# Copy to .env (or export directly) and fill in real values — none of these
# have defaults in source; the bot refuses to start without MicrosoftAppId.

# The bot's Azure App ID. Doubles as: (a) the audience the inbound JWT
# validator requires on every Connector API call, (b) the outbound Connector
# API client id used to authenticate replies back to Bot Service.
MicrosoftAppId=

# The bot's Azure App client secret, for outbound Connector API auth.
MicrosoftAppPassword=

# Required for single-tenant Azure AD app registrations.
MicrosoftAppTenantId=

# Loopback only — see src/config.ts. Public reachability, if chosen, is a
# tunnel (T0a) fronting this port, never this process binding 0.0.0.0.
TEAMS_BOT_HOST=127.0.0.1
TEAMS_BOT_PORT=3978
