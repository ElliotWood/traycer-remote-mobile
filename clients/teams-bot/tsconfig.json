{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@traycer-clients/teams-bot/*": ["./src/*"],
      "@traycer-clients/shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared/identity-registry"],
  "exclude": [
    "node_modules",
    "dist",
    "../shared/**/__tests__/**",
    "../shared/**/*.test.ts"
  ]
}
