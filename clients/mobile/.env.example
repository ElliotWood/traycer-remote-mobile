# Inputs for `bun run build:web:static` (the static /next/ web bundle).
#
# vite.config.web.ts calls requiredEnv() for every name below, so the build
# fails fast with "<NAME> is required for the web build" if one is missing or
# blank. Nothing else in the repo supplied these until this file existed, which
# meant the deployed bundle could not be rebuilt from a clean checkout.
#
# The VALUES here are placeholders. The real ones describe a specific
# deployment — but they are NOT the owner's to supply, and this file said they
# were for a day. All six are baked as one literal into the deployed entry
# chunk, which is committed to this repository on the dist branch, so the
# outgoing deployment is its own source of truth (measured 2026-09-21: the
# literal is byte-identical across dist commits 8341eeccb, 34e876685 and
# 92b1503dc, i.e. stable since 2026-08-11):
#
#   git show demo/upstream-mobile-next-dist:index.html |
#     grep -oE 'assets/index-[A-Za-z0-9_-]+\.js'         # the entry chunk
#   git show demo/upstream-mobile-next-dist:assets/index-<hash>.js |
#     grep -oE 'authnBaseUrl:`[^`]*`.*host:\{[^}]*\}'    # all six values
#
# TRAYCER_WEB_ORIGIN is authnBaseUrl minus its `/authn` suffix (the config
# derives one from the other, so invert it rather than guessing); BASE comes
# from the `assets/` prefix in index.html and the manifest `scope`; the other
# four are the `host:{…}` fields verbatim.
#
# THE GATE ON ANY REBUILD: re-extract that literal from the bundle you just
# built and require it to be byte-identical to the outgoing one. A rebuild
# whose baked config differs has silently repointed the client at another host,
# and nothing else in the build will say so.
#
# BUILD FROM POWERSHELL ON WINDOWS, NOT GIT BASH. MSYS rewrites values that
# look like POSIX paths when it hands them to a Windows process, so sourcing
# this file in Git Bash silently turns TRAYCER_WEB_BASE=/next/ into
# "C:/Program Files/Git/next/" inside the build. Measured:
#   $ TRAYCER_WEB_BASE=/next/ node -e 'console.log(process.env.TRAYCER_WEB_BASE)'
#   C:/Program Files/Git/next/
# vite only warns ("base" option should start with a slash) and BUILDS ANYWAY,
# producing a bundle whose manifest and precache paths are all wrong — the
# "/nexticons/icon-192.png" 404 described below, reported downstream as "the
# service worker did not install". Setting MSYS_NO_PATHCONV=1 also works.
#
#   PowerShell:  Get-Content .env.web | ForEach-Object {
#                  if ($_ -match '^([A-Z_]+)=(.*)$') {
#                    Set-Item "env:$($Matches[1])" $Matches[2].Trim('"') } }
#                bun run build:web:static
#
#   Git Bash:    cp .env.example .env.web && edit
#                set -a && . ./.env.web && set +a
#                MSYS_NO_PATHCONV=1 bun run build:web:static

# Scheme + host the bundle is served from, NO trailing slash.
# Used to derive authnBaseUrl (`${origin}/authn`), so it must be the origin the
# browser actually loads the app from, not the host's LAN address.
TRAYCER_WEB_ORIGIN=https://example.invalid

# Path the bundle is mounted at. The config appends a trailing slash if you
# omit one; supply it anyway. Feeds vite's `base`, the manifest scope/start_url
# and the service worker precache list — `/next` without the slash yields
# `/nexticons/icon-192.png`, a 404 that takes the whole atomic precache down.
TRAYCER_WEB_BASE=/next/

# The host this bundle is baked to talk to. Baked at BUILD time, not runtime,
# so a bundle is specific to one host.
# Recover it from the deployed entry chunk's `host:{hostId:…}` (see the header) —
# it is not guessable, but it IS in this repo, so a rebuild never waits on it.
TRAYCER_WEB_HOST_ID=00000000-0000-0000-0000-000000000000
# Display name shown in the host picker. Quote it — it usually contains spaces,
# and an unquoted value breaks `. ./.env.web` (the shell splits on the space and
# the build then fails with "TRAYCER_WEB_HOST_LABEL is required").
TRAYCER_WEB_HOST_LABEL="Example host"
# Direct websocket URL for the host. Note the relay (wss://relay.traycer.ai/attach)
# is configured separately and is not this value.
TRAYCER_WEB_HOST_WS_URL=wss://example.invalid/ws
# Host version string, surfaced in the UI and in compatibility checks.
TRAYCER_WEB_HOST_VERSION=0.0.0

# Optional. Set to 1 to emit sourcemaps.
#TRAYCER_WEB_SOURCEMAP=1
