# Copy this file to `.env` (or `.env.local`) and fill in real values for your
# environment before building/running. Never commit real values — this repo
# is public, so no tailnet FQDNs, host ids, or ports belong in a tracked file.
#
# All three are read by `src/config.ts`. Vite only exposes vars prefixed
# `VITE_` to client code (`envPrefix` in vite.config.ts) — that's why every
# entry below uses that prefix.

# WebSocket URL of the Traycer host this client should connect to.
#   Local dev:         ws://127.0.0.1:<port>/rpc
#   Tailnet/production: wss://<your-host>/rpc
# Left unset: the app shows an explicit "no host configured" screen after
# sign-in (see `App.tsx`'s `HostConfigPrompt`) — signed-in but nothing to
# talk to, RPCs can never reach a host.
VITE_HOST_WS_URL=

# The host's real, durable id — read from the host's own `pid.json`, not
# discoverable over the wire protocol itself. Stamped onto chats created
# from this client so desktop can resolve them back to the right host.
# Left unset: falls back to a synthetic id; a chat created that way renders
# as an unreachable host on desktop until this is set (see `use-create-chat.ts`).
VITE_HOST_ID=

# Base URL for AuthnV3 device-flow sign-in.
# Leave unset ONLY if this build is served from the real production origin
# (https://platform.traycer.ai) — production authn's CORS allowlist is that
# ONE origin and nothing else. Any other origin serving a build with this
# unset (a tailnet URL, a custom domain, local dev over a non-default port)
# will have every sign-in attempt fail with an opaque CORS error, because the
# unset default falls back to calling production authn directly, cross-origin.
# Prefer pointing this at a same-origin proxy path (e.g. `/authn`, proxied
# server-side to the real authn — see vite.config.ts's dev proxy) so the
# browser's request is same-origin and CORS never enters into it.
VITE_AUTHN_BASE_URL=
