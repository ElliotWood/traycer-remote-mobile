        chatId,
        userId: this.auth.lease.identity.userId,
        wsStreamClient: this.streamClient,
        auth: this.auth,
        onDiagnostic: (message) => this.logger.debug(message, null),
        resolveDefaultSettings: () => this.resolveDefaultSettings(permissionMode)
