function runWatch(bridge, epicId, logger) {
  return new Promise((resolve) => {
    let stopped = false;
    const tracker = new WatchEventTracker;
    const cleanup = () => {
      if (stopped)
        return;
      stopped = true;
      process.off("SIGINT", cleanup);
      process.off("SIGTERM", cleanup);
      clearInterval(timer);
      resolve();
    };
    process.once("SIGINT", cleanup);
    process.once("SIGTERM", cleanup);
    let running = false;
    const tick = async () => {
      if (stopped || running)
        return;
      running = true;
      try {
        const agents = await bridge.listAgents();
        const observed = await readStatuses(bridge, agents, logger);
        for (const reply of bridge.drainReplies()) {
          const event = {
            type: "appeared",
            eventId: replyEventId(reply.chatId, reply.blockId),
            kind: "text.completed",
            epicId,
            chatId: reply.chatId,
            chatTitle: observed.find((s) => s.chatId === reply.chatId)?.title ?? null,
            blockId: reply.blockId,
            text: reply.text,
            requestedAt: reply.timestamp
          };
          process.stdout.write(`${JSON.stringify(event)}
`);
        }
        for (const event of tracker.diff(epicId, observed)) {
          process.stdout.write(`${JSON.stringify(event)}
`);
        }
      } catch (err) {
        logger.warn("watch tick failed", {
          error: err instanceof Error ? err.message : String(err)
        });
      } finally {
        running = false;
      }
    };
    const timer = setInterval(() => {
      tick();
    }, WATCH_POLL_MS);
    tick();
  });
}

